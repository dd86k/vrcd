name "server"
targetType "executable"
description "VRChat event recorder and broadcaster"
authors "dd86k <dd@dax.moe>"
copyright "Copyright © 2026, dd86k <dd@dax.moe>"
license "BSD-3-Clause-Clear"

dependency "ddlogger" repository="git+https://github.com/dd86k/ddlogger.git" version="4397d8e57a88bd6b3a3e5e4c846ba97ac3bfd364"
dependency "ddcurl" repository="git+https://github.com/dd86k/ddcurl.git" version="4fc6cfa36811a7fdd6f69e6c76e1e821aa0c8b1b"
dependency "arsd-official:sqlite" version="==12.1.2"

# "." for dub.selections.json
# ".." for VERSION
stringImportPaths "." ".."

subConfiguration "ddcurl" "static"

// The notification shape is decoded identically here and in both front-ends:
// the server normalizes VRChat's REST listing through this module, the
// front-ends keep the list current from WebSocket events with the same code.
//
// badgeurl.d is the rule for what may be fetched as badge art. Badge art is
// the one request where a client names a URL rather than an object, so both
// sides check it: if they disagreed, the looser one would be the real rule.
sourceFiles "../common/source/vrcd/notifications.d" "../common/source/vrcd/badgeurl.d"

buildType "static-release" {
	buildOptions "releaseMode" "optimize" "inline"
	dflags "-L=-static" platform="dmd"
	dflags "-Wl,-static" "-static" "-static-libgcc" platform="gdc"
	dflags "--static" platform="ldc"
}
