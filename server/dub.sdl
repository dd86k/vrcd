name "server"
targetType "executable"
description "VRChat event recorder and broadcaster"
authors "dd86k <dd@dax.moe>"
copyright "Copyright © 2026, dd86k <dd@dax.moe>"
license "BSD-3-Clause-Clear"

dependency "ddlogger" repository="git+https://github.com/dd86k/ddlogger.git" version="4397d8e57a88bd6b3a3e5e4c846ba97ac3bfd364"
dependency "ddcurl" repository="git+https://github.com/dd86k/ddcurl.git" version="f9598ff6c8f146966143bedcdd0c205fd477da99"
# Packages requires static sqlite3 package (like libsqlite3-dev) and emits no other configurations
dependency "arsd-official:sqlite" version="==12.1.2"

# Needed when adding configurations
mainSourceFile "source/server/main.d"

# "." for dub.selections.json
# ".." for VERSION
stringImportPaths "." ".."

# notifications.d: Notification model that server and clients speak
# badgeurl.d: Badge info/art URLs
# timerange.d: Event timestamps, shared with the VRCX converter
# vrcx.d: VRCX converter, for a server reading a VRCX file it shares a host with
sourceFiles "../common/source/vrcd/notifications.d" "../common/source/vrcd/badgeurl.d" "../common/source/vrcd/timerange.d" "../common/source/vrcd/vrcx.d"

# Using dynamic libcurl allows libcurl to be updated with the rest of the system
configuration "application" {
	subConfiguration "ddcurl" "dynamic"
}

# For hosts that ship no libcurl new enough to load, or where a single
# self-contained binary is wanted. Needs libcurl's import library at link
# time (libcurl-x64.lib on Windows, -lcurl on POSIX).
configuration "static" {
	subConfiguration "ddcurl" "static"
}

# Make an optimized static binary of the server binary
# Highly recommended to use static configuration
buildType "static-release" {
	buildOptions "releaseMode" "optimize" "inline"
	dflags "-L=-static" platform="dmd"
	dflags "-Wl,-static" "-static" "-static-libgcc" platform="gdc"
	dflags "--static" platform="ldc"
}
