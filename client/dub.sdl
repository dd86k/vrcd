name "client"
targetType "executable"
description "VRChat event viewer and log watcher"
authors "dd86k <dd@dax.moe>"
copyright "Copyright © 2026, dd86k <dd@dax.moe>"
license "BSD-3-Clause-Clear"

dependency "ddlogger" repository="git+https://github.com/dd86k/ddlogger.git" version="653364f91d3febed0116eb792a3a899418f49927"
dependency "bindbc-sdl" version="~>1.5.2"
dependency "ddui" repository="git+https://github.com/dd86k/ddui.git" version="f33c4d246b40a26d560dad492a36ca532f331b94"

stringImportPaths ".."
versions "SDL" "SDL_2022" "SDL_TTF_2_22" "SDL_Image_200"

// Direct-IPC join support: the Windows client talks to VRChat's launch-URI
// named pipe in-process, sharing the protocol code with the pipehelper
// executable that Linux runs inside the Proton container instead.
sourceFiles "../pipehelper/source/vrcpipe.d" platform="windows"
